# flake8 reads its configuration from the project root, so without this
# file the flake8-ros pre-commit hook installs the ROS plugin set but none
# of the ROS settings, and falls back to stock defaults.
#
# Copied verbatim from ament_flake8:
# https://github.com/ament/ament_lint/blob/master/ament_flake8/ament_flake8/configuration/ament_flake8.ini
[flake8]
extend-ignore = B902,C816,D100,D101,D102,D103,D104,D105,D106,D107,D203,D212,D404,I202
import-order-style = google
max-line-length = 99
show-source = true
statistics = true
