<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apriltag_nav</name>
  <version>0.0.1</version>
  <description>Find and Navigate close to an apriltag</description>
  <maintainer email="info@tartanrobotics.com">Emanuele</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>apriltag_find</exec_depend>
