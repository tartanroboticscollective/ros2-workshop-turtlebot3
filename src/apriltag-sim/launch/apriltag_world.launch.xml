<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="x_pose" default="0"/>
  <arg name="y_pose" default="0"/>

  <append_env name="GZ_SIM_RESOURCE_PATH"
              value="$(find-pkg-share apriltag-sim)/models"/>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args"
         value="-r -s -v2 $(find-pkg-share apriltag-sim)/worlds/apriltab-box.world"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-g -v2"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>

  <include file="$(find-pkg-share turtlebot3_gazebo)/launch/robot_state_publisher.launch.py">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <include file="$(find-pkg-share turtlebot3_gazebo)/launch/spawn_turtlebot3.launch.py">
    <arg name="x_pose" value="$(var x_pose)"/>
    <arg name="y_pose" value="$(var y_pose)"/>
  </include>
</launch>
