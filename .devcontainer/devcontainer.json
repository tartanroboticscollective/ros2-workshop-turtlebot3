{
  "name": "ROS2 Jazzy Turtlebot",
  "dockerComposeFile": [
    "../docker/docker-compose-vscode.yml"
  ],
  "service": "ros2_jazzy_turblebot3",
  "workspaceFolder": "/turtlebot_ws",
  "shutdownAction": "stopCompose",
  "postStartCommand": ["bash", "-c", "source /opt/ros/${ROS_DISTRO}/setup.bash && cd /turtlebot_ws && colcon build --symlink-install"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ranch-hand-robotics.rde-ros-2",
        "ms-python.mypy-type-checker",
        "ms-python.pylint",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ]
    }
  }
}
