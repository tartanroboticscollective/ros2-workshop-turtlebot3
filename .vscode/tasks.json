{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    // Install the pixi environment
    {
      "label": "install dependencies",
      "detail": "Install the pixi environment from pixi.toml.",
      "type": "shell",
      "command": "pixi install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    // Build tasks
    {
      "label": "build",
      "detail": "Build the workspace (release).",
      "type": "shell",
      "command": "pixi run build -DCMAKE_BUILD_TYPE=Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "build debug",
      "detail": "Build the workspace (debug).",
      "type": "shell",
      "command": "pixi run build -DCMAKE_BUILD_TYPE=Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    // Test tasks
    {
      "label": "test",
      "detail": "Run all unit tests and show results.",
      "type": "shell",
      "command": "pixi run colcon test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    // Clean tasks
    {
      "label": "clean",
      "detail": "Delete the build, install and log directories.",
      "type": "shell",
      "command": "pixi run clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
